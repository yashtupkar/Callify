generator client {
  provider = "prisma-client-js"
}

// Standalone WhatsApp automation domain. WhatsAppInstance remains for legacy
// clients; new automation APIs use these provider-neutral records.
model WhatsAppAutomation {
  id                 String   @id @default(uuid())
  workspaceId        String
  name               String
  description        String?
  status             String   @default("draft")
  language           String?  @default("en-US")
  supportedLanguages String[] @default([])
  systemPrompt       String
  initialMessage     String?
  businessName       String?
  businessPhone      String?
  businessEmail      String?
  websiteUrl         String?
  industry           String?
  address            String?
  timezone           String?  @default("Asia/Kolkata")
  fallbackMode       String   @default("ai")
  fallbackMessage    String?
  handoffMessage     String?
  handoffKeywords    String[] @default([])
  tone               String?  @default("friendly")
  responseLength     String?  @default("balanced")
  setupStep          Int      @default(1)
  setupCompleted     Boolean  @default(false)
  tested             Boolean  @default(false)
  activatedAt        DateTime?
  behaviorConfig     Json?
  capabilities       Json?
  promptConfig       Json?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  workspace   Workspace                   @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  connections WhatsAppConnection[]
  tools       WhatsAppAutomationTool[]
  sessions    WhatsAppAutomationSession[]
  logs        WhatsAppAutomationLog[]
  autoReplies WhatsAppAutoReplyRule[]
  knowledgeSources WhatsAppKnowledgeSource[]
  products WhatsAppProduct[]
  faqs WhatsAppFaq[]
  businessHours WhatsAppBusinessHour[]

  @@index([workspaceId, status])
}

model WhatsAppConnection {
  id            String   @id @default(uuid())
  automationId  String
  provider      String
  phoneNumber   String
  phoneNumberId String?
  businessId    String?
  instanceId    String?
  apiToken      String?
  verifyToken   String?
  appSecret     String?
  credentials   Json?
  enabled       Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  automation WhatsAppAutomation          @relation(fields: [automationId], references: [id], onDelete: Cascade)
  sessions   WhatsAppAutomationSession[]
  inbound    WhatsAppInboundMessage[]
  campaigns  WhatsAppCampaign[]

  @@unique([automationId, phoneNumber])
  @@unique([phoneNumberId])
  @@unique([instanceId])
  @@index([provider, enabled])
}

// Durable inbox: one row per provider message. The unique key gives cross-instance and
// cross-restart webhook dedup, and 'pending' rows are replayed after a crash.
model WhatsAppInboundMessage {
  id                String   @id @default(uuid())
  connectionId      String
  providerMessageId String
  contactWaId       String
  status            String   @default("pending") // pending | done | failed | dropped
  attempts          Int      @default(0)
  payload           Json
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  connection WhatsAppConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)

  @@unique([connectionId, providerMessageId])
  @@index([status, updatedAt])
  @@index([connectionId, contactWaId, createdAt])
}

model WhatsAppAutomationTool {
  id           String   @id @default(uuid())
  automationId String
  name         String
  description  String?
  schema       Json
  config       Json?
  enabled      Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  automation WhatsAppAutomation @relation(fields: [automationId], references: [id], onDelete: Cascade)

  @@unique([automationId, name])
}

model WhatsAppAutomationSession {
  id             String   @id @default(uuid())
  automationId   String
  connectionId   String
  contactWaId    String
  status         String   @default("active")
  transcript     Json?
  lastActivityAt DateTime @default(now())
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  // Message counters
  messagesSent     Int @default(0)
  messagesReceived Int @default(0)
  messagesFailed   Int @default(0)
  llmCalls         Int @default(0)
  toolCalls        Int @default(0)

  automation WhatsAppAutomation @relation(fields: [automationId], references: [id], onDelete: Cascade)
  connection WhatsAppConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  logs       WhatsAppAutomationLog[]

  @@unique([connectionId, contactWaId])
  @@index([automationId, status])
}

model WhatsAppAutomationLog {
  id            String   @id @default(uuid())
  automationId  String
  connectionId  String?
  contactWaId   String?
  sessionId     String?
  level         String   @default("info") // info, warn, error, debug
  category      String   @default("system") // system, message, tool, auto_reply, llm, error, status
  event         String
  message       String
  metadata      Json?
  createdAt     DateTime @default(now())

  automation WhatsAppAutomation @relation(fields: [automationId], references: [id], onDelete: Cascade)
  session    WhatsAppAutomationSession? @relation(fields: [sessionId], references: [id], onDelete: SetNull)

  @@index([automationId, createdAt])
  @@index([automationId, category])
  @@index([sessionId, createdAt])
}

model WhatsAppAutoReplyRule {
  id            String   @id @default(uuid())
  automationId  String
  name          String   @default("Auto-reply")
  triggerType   String   // button_press, list_row, keyword, flow_reply, first_message, always
  triggerKey    String?  // button id, row id, keyword (lowercase), or null for always
  triggerValue  String?  // exact match value, or null
  matchMode     String   @default("exact") // exact, contains, regex, prefix
  response      String   // text or JSON response
  responseConfig Json?
  responseType String   @default("text") // text, button, list, media, template
  priority      Int      @default(0)
  enabled       Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  automation WhatsAppAutomation @relation(fields: [automationId], references: [id], onDelete: Cascade)

  @@unique([automationId, triggerType, triggerKey])
  @@index([automationId, enabled])
}

model WhatsAppKnowledgeSource {
  id            String   @id @default(uuid())
  automationId  String
  type          String
  title         String
  content       String?
  sourceUrl     String?
  fileName      String?
  mimeType      String?
  enabled       Boolean  @default(true)
  metadata      Json?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  automation WhatsAppAutomation @relation(fields: [automationId], references: [id], onDelete: Cascade)
  @@index([automationId, enabled])
}

model WhatsAppProduct {
  id           String   @id @default(uuid())
  automationId String
  name         String
  description  String?
  category     String?
  price        String?
  imageUrl     String?
  enabled      Boolean  @default(true)
  metadata     Json?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  automation WhatsAppAutomation @relation(fields: [automationId], references: [id], onDelete: Cascade)
  @@index([automationId, enabled])
}

model WhatsAppFaq {
  id           String   @id @default(uuid())
  automationId String
  question     String
  answer       String
  keywords     String[] @default([])
  enabled      Boolean  @default(true)
  priority     Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  automation WhatsAppAutomation @relation(fields: [automationId], references: [id], onDelete: Cascade)
  @@index([automationId, enabled, priority])
}

model WhatsAppBusinessHour {
  id           String   @id @default(uuid())
  automationId String
  dayOfWeek    Int
  enabled      Boolean  @default(false)
  openTime     String?
  closeTime    String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  automation WhatsAppAutomation @relation(fields: [automationId], references: [id], onDelete: Cascade)
  @@unique([automationId, dayOfWeek])
}

datasource db {
  provider = "postgresql"
}

model Workspace {
  id        String   @id @default(uuid())
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  agents              Agent[]
  phoneNumbers        PhoneNumber[]
  callSessions        CallSession[]
  whatsAppInstances   WhatsAppInstance[]
  whatsAppAutomations WhatsAppAutomation[]
  users               User[]
  whatsAppCampaigns   WhatsAppCampaign[]
  whatsAppOptOuts     WhatsAppOptOut[]
}

model Agent {
  id                         String   @id @default(uuid())
  workspaceId                String
  type                       String   @default("general") // 'dental', 'general', etc.
  name                       String
  systemPrompt               String
  conversationGuidelines     String?
  initialMessage             String
  voiceId                    String?
  language                   String?  @default("en-US")
  timezone                   String?  @default("Asia/Kolkata")
  slotDuration               Int      @default(60)
  tools                      Json?
  enableEmailConfirmation    Boolean  @default(false)
  enableWhatsAppConfirmation Boolean  @default(false)
  whatsappEnabled            Boolean  @default(false)
  automationPurpose          String? // 'booking' | 'lead_capture' | 'support' | 'sales' | 'custom'
  automationStatus           String   @default("draft") // 'draft' | 'active' | 'paused'
  allowedEmails              String[] @default([])
  providers                  Json?
  flowConfig                 Json?
  createdAt                  DateTime @default(now())
  updatedAt                  DateTime @updatedAt

  workspace      Workspace      @relation(fields: [workspaceId], references: [id])
  phoneNumbers   PhoneNumber[]
  callSessions   CallSession[]
  contacts       Contact[]
  bookings       Booking[]
  availabilities Availability[]
}

model PhoneNumber {
  id                 String   @id @default(uuid())
  workspaceId        String?
  phoneNumber        String   @unique
  agentId            String?
  channel            String   @default("voice") // 'voice' | 'whatsapp'
  whatsAppInstanceId String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  workspace        Workspace?        @relation(fields: [workspaceId], references: [id])
  agent            Agent?            @relation(fields: [agentId], references: [id])
  whatsAppInstance WhatsAppInstance? @relation(fields: [whatsAppInstanceId], references: [id])
}

model WhatsAppInstance {
  id            String   @id @default(uuid())
  workspaceId   String
  provider      String // 'ultramsg' | 'cloud_api'
  phoneNumber   String // E.164
  phoneNumberId String? // Meta Cloud API phone number id
  instanceId    String? // Ultramsg instance id
  apiToken      String
  verifyToken   String
  businessId    String? // Meta WABA id
  appSecret     String? // Meta app secret for X-Hub-Signature-256 verification
  enabled       Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  workspace    Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  phoneNumbers PhoneNumber[]

  @@unique([workspaceId, phoneNumber])
}

model CallSession {
  id          String    @id @default(uuid())
  workspaceId String?
  agentId     String?
  createdAt   DateTime  @default(now())
  endedAt     DateTime?
  provider    String    @default("browser_websocket")

  // Costs
  sttCost   Float @default(0.0)
  llmCost   Float @default(0.0)
  ttsCost   Float @default(0.0)
  totalCost Float @default(0.0)

  // Usage tracking
  sttDurationSeconds  Int @default(0)
  llmPromptTokens     Int @default(0)
  llmCompletionTokens Int @default(0)
  ttsCharacters       Int @default(0)
  toolCalls           Int @default(0)

  // Full raw transcript payload
  transcript Json?

  workspace Workspace? @relation(fields: [workspaceId], references: [id])
  agent     Agent?     @relation(fields: [agentId], references: [id])
}

model Contact {
  id        String   @id @default(uuid())
  agentId   String
  name      String?
  email     String?
  phone     String?
  metadata  Json? // Stores extra fields like budget, company, etc.
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  agent    Agent     @relation(fields: [agentId], references: [id], onDelete: Cascade)
  bookings Booking[]
}

model Booking {
  id        String   @id @default(uuid())
  agentId   String
  contactId String
  startTime DateTime
  endTime   DateTime
  status    String   @default("confirmed") // 'confirmed', 'cancelled'
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  agent   Agent   @relation(fields: [agentId], references: [id], onDelete: Cascade)
  contact Contact @relation(fields: [contactId], references: [id], onDelete: Cascade)
}

model Availability {
  id        String  @id @default(uuid())
  agentId   String
  dayOfWeek Int // 0 = Sunday, 1 = Monday, ..., 6 = Saturday
  startTime String // e.g. "09:00"
  endTime   String // e.g. "17:00"
  isActive  Boolean @default(true)

  agent Agent @relation(fields: [agentId], references: [id], onDelete: Cascade)

  @@unique([agentId, dayOfWeek])
}

enum UserRole {
  admin
  user
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String
  name         String?
  role         UserRole @default(user)
  workspaceId  String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  workspace Workspace? @relation(fields: [workspaceId], references: [id], onDelete: SetNull)
}

// ---------------------------------------------------------------------------
// WhatsApp Campaigns (broadcast). Sending reuses the existing WhatsAppConnection
// providers; these tables only hold campaign state, the per-recipient queue and
// workspace-level opt-outs. status values are documented in src/campaigns/constants.js.
// ---------------------------------------------------------------------------
model WhatsAppCampaign {
  id                 String    @id @default(uuid())
  workspaceId        String
  connectionId       String?
  createdById        String?
  idempotencyKey     String?
  name               String
  channel            String // cloud_api | baileys
  status             String    @default("draft") // draft | running | paused | completed | cancelled | failed
  statusNote         String?
  templateName       String?
  templateLanguage   String?
  templateSnapshot   Json?
  messageText        String?
  variableMap        Json?
  headerMediaUrl     String?
  defaultCountryCode String?
  concurrency        Int       @default(2)
  ratePerMinute      Int       @default(30)
  maxAttempts        Int       @default(3)
  dailyLimit         Int?
  optInConfirmedAt   DateTime?
  optInConfirmedBy   String?
  optInSource        String?
  duplicateCount     Int       @default(0)
  launchedAt         DateTime?
  pausedAt           DateTime?
  completedAt        DateTime?
  cancelledAt        DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  workspace  Workspace                   @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  connection WhatsAppConnection?         @relation(fields: [connectionId], references: [id], onDelete: SetNull)
  recipients WhatsAppCampaignRecipient[]

  @@unique([workspaceId, idempotencyKey])
  @@index([workspaceId, createdAt])
  @@index([status])
  @@index([connectionId])
}

model WhatsAppCampaignRecipient {
  id                String    @id @default(uuid())
  campaignId        String
  phone             String? // normalised digits (E.164 without '+'); null when the number was invalid
  rawPhone          String?
  name              String?
  variables         Json?
  status            String    @default("pending") // pending | queued | sent | delivered | read | failed | skipped
  skipReason        String?
  attempts          Int       @default(0)
  nextAttemptAt     DateTime?
  lockedBy          String?
  lockedUntil       DateTime?
  sendStartedAt     DateTime? // set right before the provider call; a crash after this point means the outcome is unknown
  providerMessageId String?
  errorCode         String?
  errorMessage      String?
  queuedAt          DateTime?
  sentAt            DateTime?
  deliveredAt       DateTime?
  readAt            DateTime?
  failedAt          DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  campaign WhatsAppCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  @@unique([campaignId, phone])
  @@unique([providerMessageId])
  @@index([campaignId, status])
  @@index([status, nextAttemptAt])
}

// Status webhooks that arrive before the worker has stored the provider message id.
model WhatsAppCampaignStatusEvent {
  id                String   @id @default(uuid())
  connectionId      String
  providerMessageId String
  status            String
  errorCode         String?
  errorMessage      String?
  occurredAt        DateTime
  createdAt         DateTime @default(now())

  @@unique([providerMessageId])
  @@index([createdAt])
}

model WhatsAppOptOut {
  id          String   @id @default(uuid())
  workspaceId String
  phone       String
  source      String   @default("manual") // inbound_keyword | manual
  createdAt   DateTime @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, phone])
}